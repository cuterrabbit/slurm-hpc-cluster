# {{ ansible_managed }}
groups:
  - name: cluster_alerts
    rules:
      - alert: NodeDown
        expr: up{job="node"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} 응답 없음"
          description: >-
            node_exporter가 1분 넘게 스크레이프에 응답하지 않습니다.
            노드 다운 또는 네트워크 단절 가능성.

      - alert: SlurmQueueBacklog
        expr: slurm_partition_job_state_total{state="PENDING"} >= 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "파티션 {{ '{{' }} $labels.partition {{ '}}' }} 대기 잡 적체"
          description: "PENDING 잡이 5분 넘게 3개 이상 유지되고 있습니다."

      - alert: DiskSpaceLow
        expr: >-
          (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
            / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}) < 0.15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: >-
            {{ '{{' }} $labels.instance {{ '}}' }}:{{ '{{' }} $labels.mountpoint {{ '}}' }}
            디스크 여유 공간 15% 미만

      - alert: SlurmctldUnhealthy
        expr: up{job="slurm"} == 0 or slurm_node_scrape_error > 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "slurmctld 상태 이상 (헤드)"
          description: >-
            prometheus-slurm-exporter가 응답 없거나 sinfo/squeue 조회가
            실패 중입니다.

      - alert: InefficientJob
        expr: >-
          (sum by (slurmjobid) (rate(slurm_job_core_usage_total[3m])) / 1e9)
            / (count by (slurmjobid) (slurm_job_core_usage_total)) < 0.4
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: "잡 {{ '{{' }} $labels.slurmjobid {{ '}}' }} 자원 비효율 사용"
          description: >-
            요청한 코어 대비 실사용률이 40% 미만으로 3분 넘게 유지되고
            있습니다.

      - alert: MariaDBBackupStale
        expr: >-
          (time() - mariadb_backup_last_success_timestamp_seconds > 86400)
            or absent(mariadb_backup_last_success_timestamp_seconds)
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "MariaDB 백업이 24시간 넘게 성공하지 않음"
          description: >-
            마지막 성공한 백업이 24시간을 넘었거나 한 번도 성공하지
            않았습니다. mariadb-backup.timer 상태를 확인하세요.

      - alert: TetragonRetransmitSpike
        expr: increase(tetragon_tcp_retransmit_total[2m]) > 5
        for: 0m
        labels:
          severity: warning
          capture_pcap: "true"
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} TCP 재전송 급증"
          description: >-
            최근 2분간 재전송이 5회 넘게 발생했습니다(Phase 5/7a 정상 기준으로는
            0에 가까워야 함). 문제 노드에서 20초짜리 pcap 자동 캡처가 트리거됩니다
            — /apps/pcap-captures/ 아래 {{ '{{' }} $labels.instance {{ '}}' }} 이름으로
            시작하는 최신 파일을 확인하세요.
