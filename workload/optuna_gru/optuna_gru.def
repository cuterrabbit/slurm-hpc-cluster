Bootstrap: docker
From: python:3.13-slim

%files
    requirements.txt /opt/requirements.txt

%post
    grep '^torch' /opt/requirements.txt > /opt/torch-requirement.txt
    grep -v '^torch' /opt/requirements.txt > /opt/other-requirements.txt
    pip install --no-cache-dir -r /opt/torch-requirement.txt --index-url https://download.pytorch.org/whl/cpu
    pip install --no-cache-dir -r /opt/other-requirements.txt
    rm -f /opt/requirements.txt /opt/torch-requirement.txt /opt/other-requirements.txt

%environment
    export PYTHONUNBUFFERED=1

%labels
    Purpose "Phase 5 부하 생성기 실행 환경 (ADR-0012) - 코드는 이미지에 안 넣고 런타임에 바인드 마운트"
